# ===========================================================================
#  Build context = the repository root, but the Dockerfile only copies from
#  docker/php/. Everything below is excluded to keep the context small.
#
#  Explicit excludes instead of "* plus !docker/php": re-including a path
#  whose parent is excluded depends on builder details, and a context that
#  silently misses the Dockerfile is a bad trade for a shorter file.
#
#  The two generated application folders matter most: with vendor/ and
#  node_modules/ inside them they are hundreds of megabytes.
# ===========================================================================
/sylius/
/sulu/
/sylius-overlay/
/sulu-overlay/
/docs/

**/.git/
**/.github/
**/.DS_Store
**/.idea/
**/._*
**/*.log
**/*.md
**/*.swp
**/__pycache__/
**/node_modules/
**/vendor/

.dockerignore
.editorconfig
.env.docker
docker-compose*.yaml
docker-compose*.yml

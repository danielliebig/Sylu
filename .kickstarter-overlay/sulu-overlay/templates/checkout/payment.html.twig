{% extends "base.html.twig" %}

{% block page_title %}Kasse – Zahlung – Rockband Demo{% endblock %}

{% block content %}

    <section class="catalog-header">
        <div class="catalog-header__inner">
            <h1 class="catalog-header__title">Zur Kasse</h1>
            <p class="checkout-steps">
                <span>1. Adresse</span>
                <span>2. Versand</span>
                <span class="checkout-steps__current">3. Zahlung</span>
                <span>4. Übersicht</span>
            </p>
        </div>
    </section>

    <section class="checkout">
        <div class="checkout__inner">
            {#
                Zeigt ALLE im Channel konfigurierten Zahlungsarten zur
                Auswahl (aktuell: PayPal, Klarna Rechnung, Vorkasse,
                Kreditkarte) - nicht nur die von Sylius automatisch
                vorbelegte Standardart. Verifiziert (FIXES.md Nr. 27):
                eine explizit gewaehlte Zahlungsart wird tatsaechlich
                uebernommen, nicht nur die Vorschau-Vorbelegung.
            #}
            {% if methods is empty %}
                <p class="catalog__empty">
                    Für diesen Warenkorb ist aktuell keine Zahlungsart verfügbar.
                </p>
            {% else %}
                <form method="post" action="{{ path('checkout_payment_submit') }}" class="checkout-methods">
                    <input type="hidden" name="_token" value="{{ csrf_token('checkout_action') }}">

                    {% for method in methods %}
                        <label class="checkout-method checkout-method--payment">
                            <input type="radio" name="methodCode" value="{{ method.code }}"
                                   {{ method.code == selectedCode ? 'checked' : '' }} required>
                            <span class="checkout-method__info">
                                <span class="checkout-method__name">{{ method.name }}</span>
                                {% if method.description %}
                                    <span class="checkout-method__desc">{{ method.description }}</span>
                                {% endif %}
                                {% if method.instructions %}
                                    <span class="checkout-method__instructions">{{ method.instructions|nl2br }}</span>
                                {% endif %}
                            </span>
                        </label>
                    {% endfor %}

                    <button class="button button--primary" type="submit">Weiter zur Übersicht</button>
                </form>
            {% endif %}
        </div>
    </section>

{% endblock %}

{% extends "base.html.twig" %}

{# ===========================================================================
   Sulu 3 exposes template properties under the "content" namespace
   ({{ content.title }}), NOT as direct top-level variables ({{ title }})
   like in Sulu 1.x/2.x. Verified against Sulu's own, demonstrably working
   templates/pages/homepage.html.twig
   ({{ content.title }}, {{ content.article }}).

   Visible UI text below (headings, button labels) stays in German
   intentionally - this is DACH shop content, not documentation.
   =========================================================================== #}

{% block content %}

    <section class="hero">
        <div class="hero__inner">
            <p class="hero__eyebrow">Demo-Shop &middot; Sulu + Sylius</p>
            <h1 class="hero__title">{{ content.title|default('Rockband Demo') }}</h1>
            {% if content.heroSubline %}
                <p class="hero__subline">{{ content.heroSubline }}</p>
            {% endif %}
            <a class="button button--primary" href="/produkte/">Jetzt entdecken</a>
        </div>
    </section>

    {% if content.introText %}
        <section class="intro">
            <div class="intro__inner">
                <p>{{ content.introText|nl2br }}</p>
            </div>
        </section>
    {% endif %}

    <section class="featured" id="produkte">
        <div class="featured__inner">
            <h2 class="featured__title">Aktuelle Produkte</h2>

            {% set channel = content.featuredChannel|default('germany') %}
            {% set products = sylius_featured_products(channel, 6) %}

            {% if products is not empty %}
                <div class="product-grid">
                    {% for product in products %}
                        {% if product.mainTaxonCode %}
                            <a class="product-card product-card--shop"
                               href="{{ path('catalog_product', {taxonCode: product.mainTaxonCode, code: product.code}) }}">
                                {% if product.imagePath %}
                                    <span class="product-card__image" style="background-image: url('{{ product.imagePath }}')"></span>
                                {% else %}
                                    <span class="product-card__accent"></span>
                                {% endif %}
                                <span class="product-card__name">{{ product.name }}</span>
                                <span class="product-card__price">{{ product.priceCents|sylius_price }}</span>
                            </a>
                        {% else %}
                            {# No taxon known (should practically never happen) - tile without a link. #}
                            <div class="product-card">
                                <span class="product-card__accent"></span>
                                <span class="product-card__name">{{ product.name }}</span>
                            </div>
                        {% endif %}
                    {% endfor %}
                </div>
            {% else %}
                {#
                    Fallback for when the Sylius Shop API is currently
                    unreachable or returns an unexpected shape (see
                    SyliusShopClient.php - every error lands here, never
                    in a 500).
                #}
                <div class="product-grid">
                    {% for name in ['Fender Stratocaster', 'Gibson Les Paul', 'Marshall DSL40CR', 'Pearl Export EXX', 'Shure SM58', 'Boss DS-1 Distortion'] %}
                        <div class="product-card">
                            <span class="product-card__accent"></span>
                            <span class="product-card__name">{{ name }}</span>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}

            <div class="featured__footer">
                <a class="button button--secondary" href="/produkte/">Alle Kategorien ansehen</a>
            </div>
        </div>
    </section>

{% endblock %}

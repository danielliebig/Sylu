{% extends "base.html.twig" %}

{% block page_title %}Warenkorb – Rockband Demo{% endblock %}

{% block content %}

    <section class="catalog-header">
        <div class="catalog-header__inner">
            <h1 class="catalog-header__title">Warenkorb</h1>
        </div>
    </section>

    <section class="cart">
        <div class="cart__inner">
            {% if cart.items is not empty %}
                <div class="cart-items">
                    {% for item in cart.items %}
                        <div class="cart-item">
                            <div class="cart-item__info">
                                <span class="cart-item__name">{{ item.productName }}</span>
                                <span class="cart-item__price">{{ item.unitPrice|sylius_price }} / Stück</span>
                            </div>

                            <form class="cart-item__quantity" method="post"
                                  action="{{ path('cart_update', {itemId: item.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('cart_action') }}">
                                <input type="number" name="quantity" value="{{ item.quantity }}" min="1" max="99">
                                <button class="button button--secondary" type="submit">Aktualisieren</button>
                            </form>

                            <span class="cart-item__subtotal">{{ item.subtotal|sylius_price }}</span>

                            <form class="cart-item__remove" method="post"
                                  action="{{ path('cart_remove', {itemId: item.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('cart_action') }}">
                                <button class="cart-item__remove-btn" type="submit" aria-label="Entfernen">&times;</button>
                            </form>
                        </div>
                    {% endfor %}
                </div>

                <div class="cart-summary">
                    <div class="cart-summary__row">
                        <span>Zwischensumme</span>
                        <span>{{ cart.itemsSubtotal|sylius_price }}</span>
                    </div>
                    <div class="cart-summary__row">
                        <span>Versand</span>
                        <span>{{ cart.shippingTotal|sylius_price }}</span>
                    </div>
                    <div class="cart-summary__row cart-summary__row--total">
                        <span>Gesamt</span>
                        <span>{{ cart.total|sylius_price }}</span>
                    </div>
                </div>

                <div class="cart-actions">
                    <a class="button button--secondary" href="/produkte/">Weiter einkaufen</a>
                    <a class="button button--primary" href="{{ path('checkout_address') }}">
                        Zur Kasse
                    </a>
                </div>
            {% else %}
                <p class="catalog__empty">
                    Dein Warenkorb ist leer. <a href="/produkte/">Jetzt Produkte entdecken</a>.
                </p>
            {% endif %}
        </div>
    </section>

{% endblock %}

{% extends "base.html.twig" %}

{% block page_title %}Produkte – Rockband Demo{% endblock %}

{% block content %}

    <section class="catalog-header">
        <div class="catalog-header__inner">
            <h1 class="catalog-header__title">Alle Kategorien</h1>
            <p class="catalog-header__subline">Gitarren, Verstärker, Schlagzeug und mehr – direkt aus dem Sylius-Katalog.</p>
        </div>
    </section>

    <section class="catalog">
        <div class="catalog__inner">
            {% if taxons is not empty %}
                <div class="taxon-grid">
                    {% for taxon in taxons %}
                        <a class="taxon-card" href="{{ path('catalog_taxon', {taxonCode: taxon.code}) }}">
                            <span class="taxon-card__accent"></span>
                            <span class="taxon-card__name">{{ taxon.name }}</span>
                            <span class="taxon-card__cta">Ansehen &rarr;</span>
                        </a>
                    {% endfor %}
                </div>
            {% else %}
                <p class="catalog__empty">
                    Die Kategorien konnten gerade nicht geladen werden. Bitte später erneut versuchen.
                </p>
            {% endif %}
        </div>
    </section>

{% endblock %}

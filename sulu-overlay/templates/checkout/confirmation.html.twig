{% extends "base.html.twig" %}

{% block page_title %}Bestellung bestätigt – Rockband Demo{% endblock %}

{% block content %}

    <section class="checkout-confirmation">
        <div class="checkout-confirmation__inner">
            <p class="checkout-confirmation__icon">✅</p>
            <h1>Vielen Dank für deine Bestellung!</h1>
            <p class="checkout-confirmation__number">Bestellnummer: <strong>{{ orderNumber }}</strong></p>
            <p class="checkout-confirmation__meta">
                Eine Bestätigung wurde an deine E-Mail-Adresse gesendet
                (im Demo-Modus einsehbar unter <a href="/mail/">Mailpit</a>).
            </p>
            <a class="button button--primary" href="/produkte/">Weiter einkaufen</a>
        </div>
    </section>

{% endblock %}

{% extends "base.html.twig" %}

{% block page_title %}{{ taxonName }} – Rockband Demo{% endblock %}

{% block content %}

    <section class="catalog-header">
        <div class="catalog-header__inner">
            <p class="catalog-header__breadcrumb">
                <a href="{{ path('catalog_taxons') }}">Alle Kategorien</a> / {{ taxonName }}
            </p>
            <h1 class="catalog-header__title">{{ taxonName }}</h1>
        </div>
    </section>

    <section class="catalog">
        <div class="catalog__inner">
            {% if products is not empty %}
                <div class="product-grid">
                    {% for product in products %}
                        <a class="product-card product-card--shop"
                           href="{{ path('catalog_product', {taxonCode: taxonCode, code: product.code}) }}">
                            {% if product.imagePath %}
                                <span class="product-card__image" style="background-image: url('{{ product.imagePath }}')"></span>
                            {% else %}
                                <span class="product-card__accent"></span>
                            {% endif %}
                            <span class="product-card__name">{{ product.name }}</span>
                            {% if product.shortDescription %}
                                <span class="product-card__desc">{{ product.shortDescription }}</span>
                            {% endif %}
                            <span class="product-card__price">
                                {{ product.priceCents|sylius_price }}
                                {% if product.originalPriceCents %}
                                    <span class="product-card__price-original">{{ product.originalPriceCents|sylius_price }}</span>
                                {% endif %}
                            </span>
                            {% if product.inStock == false %}
                                <span class="product-card__stock product-card__stock--out">Ausverkauft</span>
                            {% endif %}
                        </a>
                    {% endfor %}
                </div>
            {% else %}
                <p class="catalog__empty">
                    In dieser Kategorie sind aktuell keine Produkte verfügbar, oder die Sylius-API
                    war beim Laden nicht erreichbar.
                </p>
            {% endif %}
        </div>
    </section>

{% endblock %}

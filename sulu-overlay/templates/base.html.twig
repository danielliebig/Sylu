{# ===========================================================================
   Shared base layout - used only by our own templates (rockband_landing),
   not by Sulu's built-in default/homepage templates. No risk to their
   unknown structure.

   html lang="de" and the visible text below (nav labels, footer) stay in
   German intentionally - this is DACH shop content, not documentation.
   =========================================================================== #}
<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block page_title %}{{ content.title|default('Rockband Demo') }} – Rockband Demo{% endblock %}</title>
    <meta name="description" content="{{ content.heroSubline|default('Gitarren, Verstaerker, Schlagzeug und mehr - Demo-Shop fuer DACH.') }}">
    <link rel="stylesheet" href="/css/site.css">
</head>
<body>

    <header class="site-header">
        <div class="site-header__inner">
            <a class="site-logo" href="/">
                <span class="site-logo__icon">🎸</span>
                <span class="site-logo__text">Rockband&nbsp;Demo</span>
            </a>
            <nav class="site-nav">
                <a href="/">Start</a>
                <a href="/produkte/" class="site-nav__cta">Produkte</a>
                {#
                    Calls the Sylius API once per page load if a cart token
                    already exists (CartManager::getSummary - read-only,
                    never creates a cart just for the badge). No caching at
                    this stage - acceptable for a demo, would be worth
                    revisiting for production traffic.
                #}
                {% set cartSummary = sylius_cart_summary() %}
                <a href="/warenkorb/" class="site-nav__cart">
                    🛒
                    {% if cartSummary.count > 0 %}
                        <span class="site-nav__cart-badge">{{ cartSummary.count }}</span>
                    {% endif %}
                </a>
            </nav>
        </div>
    </header>

    <main>
        {% block content %}{% endblock %}
    </main>

    <footer class="site-footer">
        <div class="site-footer__inner">
            <p class="site-footer__brand">🎸 Rockband Demo GmbH</p>
            <p class="site-footer__meta">
                Demo-Shop &middot; Sulu CMS + Sylius E-Commerce &middot; DACH
            </p>
            {#
                Sylius' own shop frontend is switched off (headless
                rebuild). Catalog pages now run independently in Sulu
                under /produkte/.

                Austria/Switzerland still not linked separately: they have
                their own hostnames (austria.localhost /
                switzerland.localhost), which the Caddy router doesn't
                distinguish.
            #}
            <nav class="site-footer__nav">
                <a href="/produkte/">Produkte</a>
                <a href="/admin/">Sulu Admin</a>
                <a href="/shop/admin/">Sylius Admin</a>
            </nav>
        </div>
    </footer>

</body>
</html>

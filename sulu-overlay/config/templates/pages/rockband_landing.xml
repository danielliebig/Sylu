<?xml version="1.0" ?>
<!--
    Custom Sulu page template "landing".

    EVERY VALUE IN THIS FILE IS VERIFIED AGAINST THE ACTUALLY INSTALLED
    SULU 3.0 CODE, NOT COPIED FROM OLDER SULU 1.x/2.x EXAMPLES.
    Specifically cross-checked:

      - <controller>: taken from vendor/sulu/sulu/.../config/templates/pages/homepage.xml
        (Sulu's own, demonstrably working template) - reads
        Sulu\Content\UserInterface\Controller\Website\ContentController,
        NOT Sulu\Bundle\WebsiteBundle\Controller\DefaultController as
        shown in older documentation.

      - <property name="url" type="route">: also taken from homepage.xml.
        "route" is Sulu's own, canonical field type for page URLs - not
        "resource_locator" (no longer a registered field type in Sulu 3,
        see the error message "There is no field with key
        resource_locator registered").

    Deliberately uses ONLY text_line/text_area/route - no media selection
    (single_media_selection), whose exact Twig binding wasn't verified
    against a running instance. The hero comes purely from CSS instead -
    no image dependency, no failure risk.

    IMPORTANT WHEN RENDERING: Sulu 3 exposes template properties in Twig
    under the "content" namespace ({{ content.title }}), not as direct
    top-level variables ({{ title }}) like in Sulu 1.x/2.x. See
    templates/pages/rockband_landing.html.twig.
-->
<template xmlns="http://schemas.sulu.io/template/template"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://schemas.sulu.io/template/template http://schemas.sulu.io/template/template-1.0.xsd">

    <key>rockband_landing</key>
    <view>pages/rockband_landing</view>
    <controller>Sulu\Content\UserInterface\Controller\Website\ContentController::indexAction</controller>
    <cacheLifetime>0</cacheLifetime>

    <meta>
        <title lang="de">Demo Landingpage</title>
        <title lang="en">Demo Landing Page</title>
    </meta>

    <properties>
        <property name="title" type="text_line" mandatory="true">
            <meta>
                <title lang="de">Titel</title>
                <title lang="en">Title</title>
            </meta>
            <params>
                <param name="headline" value="true"/>
            </params>
            <tag name="sulu.rlp.part"/>
        </property>

        <property name="url" type="route" mandatory="true">
            <meta>
                <title lang="de">Adresse</title>
                <title lang="en">Resource Locator</title>
            </meta>
            <tag name="sulu.rlp"/>
        </property>

        <property name="heroSubline" type="text_line">
            <meta>
                <title lang="de">Hero-Unterzeile</title>
                <title lang="en">Hero Subline</title>
            </meta>
        </property>

        <property name="introText" type="text_area">
            <meta>
                <title lang="de">Einleitungstext</title>
                <title lang="en">Intro Text</title>
            </meta>
        </property>

        <property name="featuredChannel" type="text_line">
            <meta>
                <title lang="de">Sylius-Channel fuer Produktvorschau (germany / austria / switzerland)</title>
                <title lang="en">Sylius channel for the product teaser</title>
            </meta>
        </property>
    </properties>

</template>

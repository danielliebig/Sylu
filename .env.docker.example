# ===========================================================================
#  Copy to .env.docker  ->  cp .env.docker.example .env.docker
#
#  This file belongs to docker compose. The file .env belongs to Symfony -
#  that's why there are two separate files. The Makefile always calls
#  docker compose with --env-file .env.docker.
# ===========================================================================

APP_ENV=dev
APP_DEBUG=1
APP_SECRET=please_set_a_random_string_here_min_32_chars

# Host ports
HTTP_PORT=80
SYLIUS_ADMIN_PORT=8082
MYSQL_PORT=3307
PMA_PORT=8081

# Database
MYSQL_ROOT_PASSWORD=root
MYSQL_USER=demo
MYSQL_PASSWORD=demo
SULU_DB=sulu_demo
SYLIUS_DB=sylius_demo

# Admin
SULU_ADMIN_EMAIL=admin@demo.de

# NOTE: no versions here. PHP, MySQL and Node.js are derived from
# kickstarter.yaml into versions.env (make versions), and docker compose
# reads that file first. A version set here would override the derived one,
# which is how an old PHP version used to sneak in when this file was
# copied over from an older version folder. make verify section 18 fails if
# it reappears.

# Only set this if you need to force the architecture.
# Not needed on the M5 - Docker picks arm64 automatically.
# DOCKER_DEFAULT_PLATFORM=linux/arm64

# ===========================================================================
#  Adyen payment gateway (see FIXES.md No. 30)
#
#  Leave empty for demo mode - the Adyen payment method stays disabled in
#  Sylius admin (:8082/admin/) either way. Fill in once real sandbox
#  credentials are available, then enable it with:
#      make payments-live
#  Switch back to demo mode any time with:
#      make payments-demo
# ===========================================================================
ADYEN_ENVIRONMENT=test
ADYEN_MERCHANT_ACCOUNT=
ADYEN_API_KEY=
ADYEN_CLIENT_KEY=
ADYEN_HMAC_KEY=

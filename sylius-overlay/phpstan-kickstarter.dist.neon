# ===========================================================================
#  PHPStan configuration for THIS project's own PHP code only
#  (see FIXES.md No. 40)
#
#  DELIBERATELY A DIFFERENT FILENAME than Sylius' own phpstan.dist.neon:
#  Sylius Standard ships its own config at that exact path, and
#  overwriting it would repeat the mistake from FIXES.md No. 3
#  (our _sylius.yaml silently displacing Sylius' own file of the same
#  name). Run this one explicitly:
#
#      make phpstan
#      # or, inside the container:
#      vendor/bin/phpstan analyse -c phpstan-kickstarter.dist.neon
#
#  WHY LEVEL 5 AND NOT SYLIUS' OWN LEVEL 9:
#  Measured, not guessed - our two files produce 3 findings at level 5
#  and 52 at level 9. The bulk of the level-9 findings come from the
#  deliberately untyped `object` parameters on the Sylius repository
#  constructor arguments, which are NOT an oversight: they're the fix
#  from FIXES.md No. 6/7, adopted after Sylius moved interface
#  namespaces between versions and broke a hard type hint. Satisfying
#  level 9 would mean reintroducing exactly the brittleness that fix
#  removed. Level 5 still catches the class of bug that actually hurt
#  this project before - FIXES.md No. 12's call to a setMetaTitle()
#  method that doesn't exist would have been caught here, before the
#  first run.
#
#  The Sulu side needs no equivalent file: Sulu ships its own
#  phpstan.dist.neon at level `max`, and all seven of our overlay
#  classes already pass it cleanly (verified).
# ===========================================================================

parameters:
    level: 5
    paths:
        - src/Fixture/
        - src/Command/

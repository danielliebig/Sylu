# ===========================================================================
#  Generated applications
#
#  Both are created by docker/scripts/install-apps.sh from sylius-overlay/
#  and sulu-overlay/, which are the source of truth. Their vendor/, var/,
#  node_modules/ and the skeleton boilerplate all live inside these two
#  folders, which is why the whole thing is a two-line rule now.
#
#  What IS committed: each overlay's composer.json and composer.lock, so
#  make setup installs the reviewed dependency set (docs/decisions.md,
#  ADR-11).
# ===========================================================================
/sylius/
/sulu/

# ===========================================================================
#  Local credentials
#
#  .env.docker.example IS tracked; the real .env.docker is not. Versions
#  do NOT belong in it - they come from the generated versions.env, which
#  is tracked on purpose.
# ===========================================================================
/.env.docker

# ===========================================================================
#  Editor / OS
# ===========================================================================
.DS_Store
.idea/
.vscode/
*.swp
*~
__pycache__/

# verify.sh writes its fixture reference here (section 4)
/var/

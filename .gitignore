# ===========================================================================
#  Generated by install-apps.sh — never commit
#
#  .kickstarter-overlay/  Snapshot of our own files, taken in step 1 before
#                         the Sylius installer overwrites them, restored in
#                         step 3. Step 1 is SKIPPED once Sylius is installed,
#                         so a committed copy freezes and silently diverges
#                         from the project root.
#  .sylius-original/      Sylius' own compose.yml, moved aside in step 0 so
#                         that "docker compose" does not give it precedence.
#
#  Both are recreated on a fresh setup — a clone without them works.
# ===========================================================================
/.kickstarter-overlay/
/.sylius-original/

# ===========================================================================
#  Dependencies — Composer/yarn managed, come back via install
#
#  composer.json AND composer.lock are deliberately NOT ignored: the fixed
#  versions in arc42 ch. 2 are only reproducible with the lock file.
#  See README.md, "For development teams".
# ===========================================================================
/vendor/
/node_modules/

# ===========================================================================
#  Generated Sulu application (./sulu)
#
#  Built by make sulu-theme + install-apps.sh from sulu-overlay/, which is
#  the source of truth. install-apps.sh itself treats ./sulu as not-ours
#  (STASH_EXCLUDES), so the whole folder stays out of the repo.
# ===========================================================================
/sulu/

# ===========================================================================
#  Runtime, cache and uploads
# ===========================================================================
/var/*
/public/media/
/public/build/
/public/bundles/
.phpunit.result.cache
.phpunit.cache/

# Product photos are NOT downloaded (the Pixabay tier was removed in
# FIXES.md No. 38 — the CDN returns 403). var/demo-images/ holds
# hand-supplied photos that ship with the kickstarter, so it stays tracked.
# Note: /var/* (not /var/) plus this step-by-step re-inclusion is required —
# Git cannot re-include anything below an excluded parent directory.
!/var/demo-images/
/var/demo-images/*
!/var/demo-images/*.jpg

# ===========================================================================
#  Environment and credentials
#
#  .env.docker.example IS tracked; the real .env.docker with credentials
#  is not.
# ===========================================================================
/.env.docker
/.env.local
/.env.*.local

# ===========================================================================
#  Editor / OS
# ===========================================================================
.DS_Store
.idea/
.vscode/
*.swp
*~

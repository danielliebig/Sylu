# --- Dependencies (regenerated by composer/yarn) ---
/vendor/
/node_modules/
/sulu/vendor/
/sulu/node_modules/

# --- Generated Sulu application ---
# Built by make sulu-theme + docker/scripts/install-apps.sh from sulu-overlay/.
# Never edit directly; the overlay is the source of truth.
/sulu/

# --- Runtime and cache ---
/var/
/sulu/var/
.phpunit.result.cache
.phpunit.cache/

# --- Compiled assets ---
/public/build/
/public/bundles/
/sulu/public/build/
/sulu/public/bundles/

# --- Environment and credentials ---
# .env.docker.example IS tracked; the real file with credentials is not.
/.env.docker
/.env.local
/.env.*.local
/sulu/.env.local
/sulu/.env.*.local

# --- Editor and OS ---
.idea/
.vscode/
*.swp
*~
.DS_Store
